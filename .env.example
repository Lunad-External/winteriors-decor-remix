# Settings the app reads, with local-development values. Copy to `.env.local` (git-ignored)
# and adjust; `.env.local` overrides `.env`.
# `.env` (committed) mirrors the server's settings in ~/.config/winteriors/app.env (see docs/SERVER.md).

# --- Database (required) ---
# The app uses DB_Connection, falling back to DATABASE_URL. Set both to the same value.
# Local Postgres: the password can come from %APPDATA%\postgresql\pgpass.conf (Windows) or ~/.pgpass.
# Add ?sslmode=require only for hosted databases that need SSL (e.g. Neon); a local Postgres has none.
DB_Connection=postgresql://postgres@localhost:5432/winteriors
DATABASE_URL=postgresql://postgres@localhost:5432/winteriors

# --- Google Drive (needed for the admin panel's Drive sync) ---
GOOGLE_API_KEY=

# --- Optional ---
# Where resized Drive images are cached on disk (default: ./.cache/drive-images)
# IMAGE_CACHE_DIR=
# SMTP2GO key for enquiry emails (the code has a built-in key if this is not set)
# SMTP2GO_API_KEY=

# --- Legacy (Lovable/Supabase era; only the unsubscribe page and an unused auth middleware read these) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
